# --- Supabase (client-side, public — safe under Row-Level Security) ---
# Leave both BLANK to run the app in local-only mode (SQLite/localStorage, no login).
# Find these in the Supabase dashboard: Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Groq (SERVER-SIDE ONLY) ---
# Read by the Vercel serverless function at /api/groq. NEVER prefix with VITE_,
# or it would be exposed in the client bundle. Set it in Vercel project env vars
# (and in a local .env for `vercel dev`). Get a key at https://console.groq.com.
GROQ_API_KEY=
